# Secure Blog CMS - Safe Configuration (Apache 2.4+)

# 1. Set default index file
DirectoryIndex index.php

# 2. Explicitly allow access to the site
# This fixes 403 errors if the server default is Deny
Require all granted

# 3. Protect Internal Directories via Rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to data directory
    RewriteRule ^data/ - [F,L]

    # Block access to includes directory
    RewriteRule ^includes/ - [F,L]

    # Pretty URLs (WordPress-style)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Short URLs: /s/abc123 → s.php?code=abc123
    RewriteRule ^s/([a-zA-Z0-9]+)/?$ s.php?code=$1 [L,QSA]

    # Category: /category/tech → index.php?category=tech
    RewriteRule ^category/([a-zA-Z0-9\-]+)/?$ index.php?category=$1 [L,QSA]

    # Tag: /tag/mytag → index.php?tag=mytag
    RewriteRule ^tag/([a-zA-Z0-9\-]+)/?$ index.php?tag=$1 [L,QSA]

    # Post: /post/my-slug → post.php?slug=my-slug
    RewriteRule ^post/([a-zA-Z0-9\-]+)/?$ post.php?slug=$1 [L,QSA]

    # Page: /page/2 → index.php?page=2
    RewriteRule ^page/([0-9]+)/?$ index.php?page=$1 [L,QSA]
</IfModule>

# 4. Protect Sensitive Files
<FilesMatch "^(config\.php|version\.json|install\.php)$">
    Require all denied
</FilesMatch>

# 5. Protect Backup and Log Files
<FilesMatch "\.(bak|old|tmp|log|md|txt|swp)$">
    Require all denied
</FilesMatch>

# 6. Disable Directory Listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
