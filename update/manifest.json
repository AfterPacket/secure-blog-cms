    "changes": [
        "Fix RCE vulnerability in upgrade system (Upgrader.php)",
        "Fix XSS bypass in content output sanitization (Security.php)",
        "Fix CSRF token replay across sessions (Security.php)",
        "Fix proxy header spoofing (X-Forwarded-For) in login (login.php)",
        "Add strict role validation in admin endpoints (config.php)",
        "Migrate password hashing to Argon2id (users.php)",
        "Harden comment sanitization against stored XSS (comments.php)",
        "Secure image upload with strict MIME validation (upload-image.php)",
        "Add secure image serving with path traversal protection (serve-image.php)",
        "Harden upgrade endpoint with signature verification (upgrade.php)",
        "Add CSP headers and security response headers (config.php, s.php)",
