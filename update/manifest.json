    "changes": [
        "Fix RCE vulnerability in upgrade system (Upgrader.php)",
        "Fix XSS bypass in content output sanitization (Security.php)",
        "Fix CSRF token replay across sessions (Security.php)",
        "Fix proxy header spoofing (X-Forwarded-For) in login (login.php)",
        "Add strict role validation in admin endpoints (config.php)",
        "Migrate password hashing to Argon2id (users.php)",
        "Harden comment sanitization against stored XSS (comments.php)",
        "Secure image upload with strict MIME validation (upload-image.php)",
        "Add secure image serving with path traversal protection (serve-image.php)",
        "Harden upgrade endpoint with signature verification (upgrade.php)",
        "Add CSP headers and security response headers (config.php, s.php)",
        "Enforce password protection on posts (post.php, index.php, rss.php, Storage.php)",
        "Filter private posts from non-authenticated users (index.php, Storage.php)",
        "Add password-protected indicators in listings (index.php, index_template.php)",
        "Fix image upload CSRF token refresh for multi-image uploads (upload-image.php, create-post.php, edit-post.php)",
        "Add WordPress-style pretty URLs via .htaccess rewrite rules",
        "Add category and tag browsing on public pages (index.php)",
        "Add category/tag display on post pages (post.php)",
        "Add categories to RSS feed items (rss.php)",
        "Update short URLs to use pretty URL format (UrlShortener.php, s.php)",
        "Update version to 1.4.0 (version.json, config.php)"
    ]
}